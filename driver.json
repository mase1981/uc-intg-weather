{
  "driver_id": "weather_display",
  "version": "2.2.0",
  "min_core_api": "0.18.0",
  "name": {
    "en": "Weather Display",
    "de": "Wetter Anzeige",
    "fr": "Affichage Météo"
  },
  "description": {
    "en": "Display current weather conditions with beautiful icons",
    "de": "Aktuelle Wetterbedingungen mit schönen Symbolen anzeigen",
    "fr": "Afficher les conditions météorologiques actuelles avec de belles icônes"
  },
  "developer": {
    "name": "Meir Miyara",
    "email": "meir.miyara@example.com",
    "url": "https://github.com/mase1981"
  },
  "home_page": "https://github.com/mase1981/uc-intg-weather",
  "icon": "uc:weather",
  "setup_data_schema": {
    "title": {
      "en": "Weather Location",
      "de": "Wetter Standort",
      "fr": "Emplacement Météo"
    },
    "settings": [
      {
        "id": "location",
        "label": {
          "en": "Location (ZIP/Postal code or City, State/Country)",
          "de": "Standort (PLZ oder Stadt, Bundesland/Land)",
          "fr": "Emplacement (Code postal ou Ville, État/Pays)"
        },
        "field": {
          "text": {
            "value": ""
          }
        }
      },
      {
        "id": "latitude",
        "label": {
          "en": "Latitude (optional, if not using Location above)",
          "de": "Breitengrad (optional, wenn oben kein Standort angegeben)",
          "fr": "Latitude (optionnel, si aucun emplacement ci-dessus)"
        },
        "field": {
          "text": {
            "value": ""
          }
        }
      },
      {
        "id": "longitude",
        "label": {
          "en": "Longitude (optional, if not using Location above)",
          "de": "Längengrad (optional, wenn oben kein Standort angegeben)",
          "fr": "Longitude (optionnel, si aucun emplacement ci-dessus)"
        },
        "field": {
          "text": {
            "value": ""
          }
        }
      },
      {
        "id": "location_name",
        "label": {
          "en": "Display Name (optional, for lat/lon)",
          "de": "Anzeigename (optional, für Lat/Lon)",
          "fr": "Nom d'affichage (optionnel, pour lat/lon)"
        },
        "field": {
          "text": {
            "value": ""
          }
        }
      },
      {
        "id": "use_celsius",
        "label": {
          "en": "Use Celsius (°C) instead of Fahrenheit (°F)",
          "de": "Celsius (°C) statt Fahrenheit (°F) verwenden",
          "fr": "Utiliser Celsius (°C) au lieu de Fahrenheit (°F)"
        },
        "field": {
          "checkbox": {
            "value": false
          }
        }
      }
    ]
  }
}